# Copy this file to .env and adjust values as needed.

# Default is a local SQLite file, so the project runs with zero external setup.
# For production, point this at PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://hiresense:hiresense@db:5432/hiresense
DATABASE_URL=sqlite:///./hiresense.db

# Change this in any real deployment. Used to sign JWTs.
SECRET_KEY=change-this-to-a-long-random-string-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
